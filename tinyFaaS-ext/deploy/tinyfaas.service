# systemd unit for the tinyFaaS management service (and the rproxy it
# spawns) on a cluster node (leader or worker). systemd's job is to start it
# on boot and restart it if it dies, since a relay power-on gives the node a
# fresh boot with nothing running yet.
#
# Use the binary built from THIS repository, not upstream tinyFaaS. Workers
# are not stock nodes: the leader decides a worker is ready by polling
# /health on its management API, and that endpoint exists only here. A
# worker running upstream tinyFaaS powers on, never answers /health, fails
# the readiness check, and is marked dead -- so every wake fails.
#
# The same binary serves both roles; only the environment differs. A worker
# needs no configuration at all: with NODES_CONFIG unset the rproxy runs
# single-node and never tries to power-cycle anything. The leader is the one
# that gets NODES_CONFIG, TINKERFORGE_UID and POWER_AWARE (see README).
#
# Install:
#   1. copy the built binary for this host's arch, e.g. tinyfaas-linux-arm64,
#      to /opt/tinyfaas/tinyfaas-mgmt
#   2. copy this file to /etc/systemd/system/tinyfaas.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now tinyfaas
#
# The service user must be able to reach the Docker socket (member of the
# `docker` group) and needs a writable working directory for tinyFaaS's
# ./tmp scratch space.
#
# On the leader, add the environment via a drop-in rather than editing this
# file:
#   sudo systemctl edit tinyfaas
#   [Service]
#   Environment=NODES_CONFIG=/opt/tinyfaas/nodes.json
#   Environment=TINKERFORGE_UID=...
#   Environment=POWER_AWARE=true

[Unit]
Description=tinyFaaS management service
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Never give up restarting. systemd's default is to stop trying after 5
# starts in 10s and leave the unit failed, which on an unattended worker
# means it stays dead until someone logs in -- and the only symptom is a
# node the leader quietly marks dead mid-experiment.
StartLimitIntervalSec=0

[Service]
Type=simple
User=tinyfaas
WorkingDirectory=/opt/tinyfaas
ExecStart=/opt/tinyfaas/tinyfaas-mgmt

# always, not on-failure: the management service exits 0 when it receives a
# signal, and on-failure does not restart a clean exit. A worker that took a
# stray SIGTERM would stop serving permanently while looking healthy to
# systemd.
Restart=always
RestartSec=5

# Docker may still be settling after a power-on even though systemd
# considers it started, so the first attempts can fail. That is expected and
# recovers on its own; these just stop it thrashing while it waits.
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
